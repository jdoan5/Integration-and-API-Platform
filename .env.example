# ============================================================================
# Copy to .env and adjust. .env is gitignored and must NEVER be committed.
#
# Every value here has a working default, so a local dev setup needs no .env
# at all. This file documents what is configurable and is the place to point
# a deployment at real infrastructure.
# ============================================================================

# --- PostgreSQL (the inventory_mgmt database) -------------------------------
# DB_USER defaults to your shell $USER, which is what Postgres.app creates.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_mgmt
DB_USER=
DB_PASSWORD=

# --- Service ports ----------------------------------------------------------
# SOAP=8081  REST=8082  Events=8083
SERVER_PORT=

# --- Redis (Phase 2) --------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Upstream SOAP endpoint the REST facade calls (Phase 2) -----------------
SOAP_URI=http://localhost:8081/ws

# --- Kafka + Schema Registry (Phase 4) --------------------------------------
KAFKA_BOOTSTRAP=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8085

# --- Kong consumer API keys (Phase 3) ---------------------------------------
# The keys in phase3-gateway/kong.yml are LOCAL DEMO VALUES, committed on
# purpose so the project runs with one command. For any real deployment,
# replace them with vault references:
#     key: "{vault://env/MOBILE_API_KEY}"
# and supply the value here or from your secret manager.
MOBILE_API_KEY=
PARTNER_API_KEY=
INTERNAL_API_KEY=

# --- MCP server + agent (Phase 5) -------------------------------------------
# The MCP server calls the REST facade THROUGH Kong, so it gets the same auth,
# rate limiting and correlation ID as every other consumer. 8084 rather than
# FastMCP's default 8000, which is Kong's proxy port.
MCP_BASE_URL=http://localhost:8000
MCP_API_KEY=local-demo-key-internal
MCP_EVENTS_URL=http://localhost:8083
MCP_PORT=8084

# auto = use whichever provider has credentials, else a scripted offline model
# that still drives the real tools. azure | openai | anthropic | offline | auto
MCP_LLM_PROVIDER=auto

# Azure OpenAI. DEPLOYMENT is the name you gave the deployment in the portal -
# it is NOT the model name, and mixing them up gives a 404 that says neither.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_VERSION=2024-10-21
